# Copy to .env for local development. In production, set these in the
# DigitalOcean App Platform dashboard (Settings → Environment Variables),
# marking secrets as "Encrypted". Never commit real values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local Docker Compose default shown.
DATABASE_URL=postgresql://an:an@localhost:5432/automobilitynext

# Long random string for signing sign-in tokens: openssl rand -base64 48
JWT_SECRET=
# Sign-in lifetime: access token in seconds, refresh token in days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 32 random bytes, base64, for encrypting writers' PAN and bank numbers:
#   openssl rand -base64 32
# Keep a safe copy: losing it makes stored PAN/bank numbers unreadable.
FIELD_ENCRYPTION_KEY=

# Browser origins allowed to call the API (the CMS and the news site).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public news site address, used in sitemaps and canonical URLs.
SITE_URL=http://localhost:3001
# Set to .automobilitynext.com in production so the CMS subdomain gets the sign-in cookie.
COOKIE_DOMAIN=

# Media storage: DigitalOcean Spaces (or AWS S3). Upload is off until set.
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# S3_REGION=blr1
# S3_BUCKET=automobilitynext-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://automobilitynext-media.blr1.cdn.digitaloceanspaces.com

# Running on your own computer without Spaces: keep uploads in this folder and
# serve them from the API (npm run setup turns this on). Not used in production.
# MEDIA_LOCAL_DIR=./media-uploads
# The API's address as the browser sees it, for links to those local files.
API_PUBLIC_URL=http://localhost:4000

# Publish scheduled articles every minute.
SCHEDULER_ENABLED=true
